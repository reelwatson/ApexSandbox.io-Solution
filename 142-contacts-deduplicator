public static List<Contact> ContactDeduplicator(List<Contact> contacts) {
    //code here
    List<Contact> deduplicatedContactsList = new List<Contact>();

    if (contacts == null || contacts.isEmpty()) {
        return new List<Contact>();
    }
    
    Set<String> emails = new Set<String>();
    for (Contact con : contacts) {
        // Could use ternary operator here to assign String value BUT
        // below statement is more readable
        String email = '';

        if (!String.isBlank(con.Email)) {
            email = con.Email.toLowerCase();
        }
        
        // Eliminate need for any 'continue' statement
        if (!emails.contains(email)) {
            emails.add(email);
            deduplicatedContactsList.add(con);
        }
    }
    return deduplicatedContactsList;
}

/*
Return a List that contains only the unique contacts from the original list, 
based on their Email field.
The deduplication must be case-insensitive 
(e.g., 'test@example.com' and 'Test@Example.com' are considered the same email).
If multiple contacts have the same email, 
only the first contact found in the original list should be kept.
Contacts with a null or blank email ('') should also be deduplicated. 
Only the first contact with a blank email should be kept.
*/